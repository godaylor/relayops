{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": ["VITE_*", "NEXT_PUBLIC_*"],
	"globalPassThroughEnv": [
		"PORT",
		"HOST",
		"KANEO_*",
		"RELAYOPS_*",
		"DATABASE_URL",
		"POSTGRES_*",
		"AUTH_SECRET",
		"CORS_ORIGINS",
		"DISABLE_*",
		"SMTP_*",
		"REDIS_*",
		"NOTIFICATION_SECRET_ENCRYPTION_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"@kaneo/site#build": {
			"outputs": [".next/**", "!.next/cache/**", "out/**"]
		},

		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"],
			"env": ["DATABASE_URL"]
		}
	}
}
