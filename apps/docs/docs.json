{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "almond",
	"name": "RelayOps",
	"colors": {
		"primary": "#111111",
		"light": "#fafafa",
		"dark": "#1f1f1f"
	},
	"appearance": {
		"default": "dark"
	},
	"icons": {
		"library": "lucide"
	},
	"styling": {
		"codeblocks": {
			"theme": {
				"light": "min-light",
				"dark": "min-dark"
			}
		}
	},
	"favicon": "/favicon.svg",
	"logo": {
		"light": "/logo/dark.svg",
		"dark": "/logo/light.svg"
	},
	"navigation": {
		"tabs": [
			{
				"tab": "RelayOps",
				"groups": [
					{
						"group": "Product and local operation",
						"pages": ["index", "relayops"]
					}
				]
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Upstream Kaneo (provenance)",
					"href": "https://github.com/usekaneo/kaneo",
					"icon": "github"
				}
			]
		}
	},
	"navbar": {
		"links": [
			{
				"label": "Upstream Kaneo",
				"href": "https://github.com/usekaneo/kaneo"
			}
		]
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "cursor"]
	},
	"seo": {
		"indexing": "all",
		"metatags": {
			"og:site_name": "RelayOps Docs",
			"og:type": "website"
		}
	}
}
